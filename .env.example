# =========================
# Stock Robot 环境变量示例
# 复制为 .env 后填写自己的密钥。不要把 .env 上传 GitHub。
# =========================

# AI Provider: deepseek 或 openai
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com

# DeepSeek / OpenAI Key 二选一或都填
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_API_KEY=your_api_key_here

# 邮件提醒 SMTP，QQ邮箱通常使用授权码而不是登录密码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_SENDER=your_email@qq.com
SMTP_PASSWORD=your_smtp_auth_code_here
SMTP_RECIPIENTS=receiver@example.com

# 代理可选。不需要代理时保持为空或删除。
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,api.deepseek.com,api.openai.com
